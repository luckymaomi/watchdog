{
  "name": "watchdog",
  "private": true,
  "scripts": {
    "prebuild": "npm run sync:readme",
    "build": "tsx scripts/build.mts",
    "sync:readme": "tsx scripts/sync-readme-tools.mts",
    "check:readme": "tsx scripts/sync-readme-tools.mts --check",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run test:unit && npm run test:python",
    "test:unit": "tsx scripts/build.mts && vitest run",
    "test:python": "python -X utf8 -m unittest discover -s tests/python -p test_*.py",
    "test:watch": "tsx scripts/build.mts && vitest",
    "test:smoke": "tsx scripts/build.mts && vitest run tests/smoke",
    "test:tool": "tsx scripts/build.mts && vitest run tests/tool",
    "test:habitats": "node public/tool/habitats/tests/fish-behavior.mjs && node public/tool/habitats/tests/render-policy.mjs && node public/tool/habitats/tests/plant-budget.mjs",
    "verify:deterministic": "tsx scripts/verify-deterministic-build.mts",
    "verify": "npm run check:readme && npm run typecheck && npm test && npm run verify:deterministic"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "esbuild": "0.25.8",
    "jszip": "^3.10.1",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "xlsx-js-style": "^1.2.0"
  },
  "dependencies": {
    "docx": "^9.7.1",
    "html2canvas": "^1.4.1"
  }
}
